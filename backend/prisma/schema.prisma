generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  holdings  Holding[]
}

model Holding {
  id        String   @id @default(cuid())
  symbol    String
  units     Decimal  @db.Decimal(20, 8) // or Float / Int based on your needs
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, symbol]) // optional: one row per symbol per user
}